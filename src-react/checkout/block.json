{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "slotiva/slot-picker",
	"version": "1.0.0",
	"title": "Appointment time picker",
	"category": "woocommerce",
	"description": "Lets the customer choose the appointment time on the Checkout block.",
	"parent": [ "woocommerce/checkout-fields-block" ],
	"textdomain": "mhm-slotiva",
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"inserter": false
	},
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": false
			}
		}
	}
}
