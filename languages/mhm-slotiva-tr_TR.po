msgid "MHM Slotiva"
msgstr "MHM Slotiva"

#. Description of the plugin
#: mhm-slotiva.php
msgid "WooCommerce service appointment booking: time slots chosen at checkout, payment-aware holds, an admin calendar and reminders."
msgstr "WooCommerce hizmet randevusu: ödeme sayfasında saat seçimi, ödeme yöntemine göre saat tutma, yönetim takvimi ve hatırlatmalar."

