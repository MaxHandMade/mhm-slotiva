msgstr "İndirme bağlantısının süresi doldu. Sayfayı yenileyip yeniden dene."

#: src/Admin/RestController.php:521
msgid "Customer name is required."
msgstr "Müşteri adı gerekli."

#: src/Admin/RestController.php:581
msgid "This appointment was changed in the meantime. Reload and try again."
msgstr "Bu randevu bu arada değiştirildi. Sayfayı yenileyip yeniden dene."

#. translators: 1: booking ID, 2: booking date and time, 3: administrator display name
#: src/Admin/RestController.php:637
#, php-format
msgid "MHM Slotiva: booking #%1$d (%2$s) was cancelled by %3$s. The time slot is free again. The order itself was not changed; cancel or refund it in WooCommerce if needed."
msgstr "MHM Slotiva: #%1$d numaralı randevu (%2$s) %3$s tarafından iptal edildi. Saat yeniden boş. Siparişin kendisi değiştirilmedi; gerekirse WooCommerce'te iptal et ya da iade et."

#. translators: 1: number of hours, 2: new deadline (local date and time), 3: administrator display name
#: src/Admin/RestController.php:691
#, php-format
msgid "MHM Slotiva: the bank-transfer payment deadline was extended by %1$d hours to %2$s by %3$s."
msgstr "MHM Slotiva: havale ödeme süresi %3$s tarafından %1$d saat uzatıldı; yeni son: %2$s."

#. translators: %s: parameter name
#: src/Admin/RestController.php:735
#, php-format
msgid "Missing parameter(s): %s"
msgstr "Eksik parametre: %s"

#. translators: %d: product ID
#: src/Admin/RestController.php:1001
#, php-format
msgid "Product #%d"
msgstr "Ürün #%d"

#: src/Admin/RestController.php:1072
msgid "an administrator"
msgstr "bir yönetici"

#: src/Admin/RestController.php:1152
msgid "That time is no longer available."
msgstr "Bu saat artık boş değil."

#: src/Admin/RestController.php:1160
msgid "Too many pending bookings."
msgstr "Ödeme bekleyen randevu sayısı çok fazla."

#: src/Admin/RestController.php:1162
msgid "This booking is being updated. Please try again in a moment."
msgstr "Bu randevu şu anda güncelleniyor. Lütfen biraz sonra yeniden dene."

#: src/Admin/RestController.php:1181
msgid "Not found."
msgstr "Bulunamadı."

#: src/Admin/RestController.php:1186
msgid "That time is outside working hours or not on the 15-minute grid."
msgstr "Bu saat çalışma saatlerinin dışında ya da 15 dakikalık adıma uymuyor."

#: src/Admin/RestController.php:1191
msgid "This appointment cannot be changed in its current status."
msgstr "Bu randevu şu anki durumunda değiştirilemez."

#: src/Admin/RestController.php:1196
msgid "Only an unexpired bank-transfer hold can be extended."
msgstr "Yalnız süresi dolmamış havale tutması uzatılabilir."

#: src/Availability/RestController.php:137
msgid "Too many requests. Please try again in a moment."
msgstr "Çok fazla istek. Lütfen biraz sonra tekrar dene."

#: src/Availability/RestController.php:143
msgid "Product not found."
msgstr "Ürün bulunamadı."

#: src/Availability/RestController.php:163
msgid "Past dates cannot be requested."
msgstr "Geçmiş tarih istenemez."

#: src/Availability/RestController.php:167
msgid "The end date cannot be before the start date."
msgstr "Bitiş tarihi başlangıçtan önce olamaz."

#: src/Checkout/CheckoutFlow.php:135
#: src/Checkout/SlotValidator.php:45
msgid "Please choose a time for your appointment."
msgstr "Lütfen randevu için bir saat seç."

#: src/Checkout/CheckoutFlow.php:170
msgid "The time you chose was just taken. Please choose another time; your details are kept."
msgstr "Seçtiğin saat az önce doldu. Lütfen başka bir saat seç; bilgilerin korunuyor."

#: src/Checkout/CheckoutFlow.php:175
#: src/Checkout/StoreApiExtension.php:192
#: build/checkout/index.js:8
msgid "Your order is being processed. Please try again in a few seconds."
msgstr "Siparişin şu anda işleniyor. Lütfen birkaç saniye sonra yeniden dene."

#: src/Checkout/CheckoutFlow.php:177
#: build/checkout/index.js:8
msgid "You have too many bookings awaiting payment. Please complete them first or try again later."
msgstr "Ödemesi bekleyen çok fazla randevun var. Lütfen önce onları tamamla ya da biraz sonra yeniden dene."

#: src/Checkout/CheckoutFlow.php:180
msgid "This order has been replaced by a newer order and can no longer be paid. Please place a new order on the checkout page."
msgstr "Bu siparişin yerini daha yeni bir sipariş aldı; bu sipariş artık ödenemez. Lütfen ödeme sayfasından yeni bir sipariş ver."

#: src/Checkout/CheckoutFlow.php:300
msgid "Bookable services can only be bought on the current checkout page. Please contact the site administrator."
msgstr "Randevulu hizmetler yalnız güncel ödeme sayfasından satın alınabilir. Lütfen site yöneticisiyle iletişime geç."

#. translators: PHP date format for a booked slot label, e.g. "17 Kasım Salı, 10:00".
#: src/Checkout/CheckoutFlow.php:420
msgctxt "slot label date format"
msgid "j F l, H:i"
msgstr "j F l, H:i"

#: src/Checkout/CheckoutFlow.php:535
msgid "Your cart can hold only one bookable service at a time. Please remove the other one from your cart."
msgstr "Sepette aynı anda yalnız bir randevulu hizmet olabilir. Lütfen diğerini sepetten çıkar."

#: src/Checkout/SlotValidator.php:56
msgid "The chosen time could not be read. Please choose the time again."
msgstr "Seçilen saat okunamadı. Lütfen saati yeniden seç."

#: src/Checkout/SlotValidator.php:60
msgid "The same time was chosen more than once."
msgstr "Aynı saat birden fazla kez seçilmiş."

#: src/Checkout/SlotValidator.php:79
msgid "The chosen times overlap each other."
msgstr "Seçilen saatler birbiriyle çakışıyor."

#: src/Checkout/SlotValidator.php:89
msgid "The chosen time is no longer offered. Please choose another time."
msgstr "Seçilen saat artık sunulmuyor. Lütfen başka bir saat seç."

#: src/Checkout/SlotValidator.php:113
msgid "The quantity in this order does not match the number of booked times, so the order cannot be paid as it is. Please place a new order on the checkout page."
msgstr "Bu siparişteki adet, kayıtlı randevu saatlerinin sayısıyla uyuşmuyor; sipariş bu hâliyle ödenemez. Lütfen ödeme sayfasından yeni bir sipariş ver."

#: src/Checkout/SlotValidator.php:114
msgid "The quantity in your cart does not match the number of chosen times. Please reload the page and try again."
msgstr "Sepetteki adet seçilen saat sayısıyla uyuşmuyor. Lütfen sayfayı yenileyip yeniden dene."

#. translators: %d: number of time slots.
#: src/Checkout/SlotValidator.php:163
#, php-format
msgid "Choose %d time for this service."
msgid_plural "Choose %d times for this service."
msgstr[0] "Bu hizmet için %d saat seçmelisin."
msgstr[1] "Bu hizmet için %d saat seçmelisin."

#. translators: 1: minimum number of slots, 2: maximum number of slots.
#: src/Checkout/SlotValidator.php:165
#, php-format
msgid "Choose between %1$d and %2$d times for this service."
msgstr "Bu hizmet için %1$d ile %2$d arasında saat seçmelisin."

#: src/Checkout/StoreApiExtension.php:81
msgid "Chosen appointment start times (ISO-8601, UTC)."
msgstr "Seçilen randevu başlangıçları (ISO-8601, UTC)."

